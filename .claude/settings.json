{
  "_comment": "Project-level Claude Code settings shared across the team. Machine-specific overrides go in .claude/settings.local.json (gitignored).",
  "permissions": {
    "deny": [
      "Read(//0[!0-9]*.md)",
      "Read(//0[!0-9]*.txt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-carry-forward-stash.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-sprint-cards.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-heredoc-python-backslash.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-blind-staging.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/warn-commit-without-velocity.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-commit-during-mutation.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/task-clock-gate.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/task-clock-gate.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/task-clock-gate.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/task-clock-gate.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sprint-auto-advance.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "py -3.14 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-closeout-complete.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}