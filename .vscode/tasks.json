{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mobile: Build APK",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/mobile-app/scripts/build-apk.py"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Mobile: Run emulator (debug)",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/mobile-app/scripts/run-emulator.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Mobile: Run emulator (install release APK)",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/mobile-app/scripts/run-emulator.py",
        "--install-release-apk"
      ],
      "problemMatcher": []
    }
  ]
}
