// Copy this file to Secrets.xcconfig (gitignored) and fill in the values.
// Info.plist reads both through $(IOS_GMAIL_CLIENT_ID) and
// $(IOS_GMAIL_REVERSED_CLIENT_ID) (ADR-0050 Q1, Q3). Never commit real values.
//
// Source: the iOS OAuth client in Google Cloud Console (client type iOS,
// bundle ID com.myemailspamfilter).
//
// IOS_GMAIL_CLIENT_ID: the full client ID, ending in .apps.googleusercontent.com
// IOS_GMAIL_REVERSED_CLIENT_ID: the same ID with the two halves swapped, that is
//   com.googleusercontent.apps.<the part before .apps.googleusercontent.com>
IOS_GMAIL_CLIENT_ID =
IOS_GMAIL_REVERSED_CLIENT_ID =
